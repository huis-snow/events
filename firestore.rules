          request.resource.data.currentQuestion == resource.data.currentQuestion &&
          request.resource.data.clueStage == resource.data.clueStage + 1 &&
          request.resource.data.get('clueSeconds', 20) == resource.data.get('clueSeconds', 20) &&
          request.resource.data.get('stageStartedAt', null) == request.time &&
          request.resource.data.activeUids == resource.data.activeUids &&
          request.resource.data.solvedUids == resource.data.solvedUids &&
          request.resource.data.revealedAnswer == resource.data.revealedAnswer &&
          request.resource.data.get('eventId', '') == resource.data.get('eventId', '') &&
          request.resource.data.get('matchId', '') == resource.data.get('matchId', '') &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clueStage', 'stageStartedAt', 'updatedAt'
          ]);
      }

      allow get: if signedIn() && validRoomId(roomId);
      allow list: if false;

      allow create: if signedIn() &&
        validRoomId(roomId) &&
        validChosungRoom(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'lobby' &&
        request.resource.data.totalQuestions == 0 &&
        request.resource.data.keys().hasAll(['clueSeconds', 'stageStartedAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if (
          chosungOwner() &&
          validChosungRoom(resource.data) &&
          validChosungRoom(request.resource.data) &&
          request.resource.data.version == resource.data.version &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('clueSeconds', 20) == resource.data.get('clueSeconds', 20) &&
          request.resource.data.get('eventId', '') == resource.data.get('eventId', '') &&
          request.resource.data.get('matchId', '') == resource.data.get('matchId', '') &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'questions', 'totalQuestions', 'currentQuestion', 'clueStage',
            'clueSeconds', 'stageStartedAt', 'activeUids', 'solvedUids',
            'revealedAnswer', 'updatedAt'
          ])
        ) || chosungDeadlineAdvance();

      allow delete: if chosungOwner();

      match /players/{playerUid} {
        function chosungParent() {
          return get(/databases/$(database)/documents/chosungRooms/$(roomId));
        }

        function chosungParentOwner() {
          return signedIn() && chosungParent().data.ownerUid == request.auth.uid;
        }

        allow get, list: if signedIn() &&
          validRoomId(roomId) &&
          exists(/databases/$(database)/documents/chosungRooms/$(roomId));

        allow create: if signedIn() &&
          playerUid == request.auth.uid &&
          chosungParent().data.status == 'lobby' &&
          validChosungPlayer(request.resource.data) &&
          request.resource.data.score == 0 &&
          request.resource.data.solvedQuestions.size() == 0 &&
          request.resource.data.lastResult == 'none' &&
          request.resource.data.lastAwardPoints == 0 &&
          request.resource.data.joinedAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if validChosungPlayer(resource.data) &&
          validChosungPlayer(request.resource.data) &&
          request.resource.data.joinedAt == resource.data.joinedAt &&
          request.resource.data.updatedAt == request.time &&
          (
            (
              signedIn() &&
              playerUid == request.auth.uid &&
              chosungParent().data.status == 'lobby' &&
              request.resource.data.score == resource.data.score &&
              request.resource.data.solvedQuestions == resource.data.solvedQuestions &&
              request.resource.data.lastResult == resource.data.lastResult &&
              request.resource.data.lastQuestion == resource.data.lastQuestion &&
              request.resource.data.lastAwardPoints == resource.data.lastAwardPoints &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'updatedAt'])
            ) ||
            (
              chosungParentOwner() &&
              (chosungParent().data.status == 'answering' || chosungParent().data.status == 'revealed') &&
              request.resource.data.nickname == resource.data.nickname &&
              request.resource.data.score >= resource.data.score &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'score', 'solvedQuestions', 'lastResult', 'lastQuestion', 'lastAwardPoints', 'updatedAt'
              ])
            )
          );

        allow delete: if signedIn() &&
          chosungParent().data.status == 'lobby' &&
          (playerUid == request.auth.uid || chosungParentOwner());
      }

      match /secrets/{questionId} {
        function secretParent() {
          return get(/databases/$(database)/documents/chosungRooms/$(roomId));
        }

        function secretOwner() {
          return signedIn() && secretParent().data.ownerUid == request.auth.uid;
        }

        allow get, list: if secretOwner();
        allow create: if secretOwner() &&
          questionId.matches('Q0[1-7]') &&
          secretParent().data.status == 'lobby' &&
          validChosungSecret(request.resource.data) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if secretOwner() &&
          secretParent().data.status == 'lobby' &&
          validChosungSecret(resource.data) &&
          validChosungSecret(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'updatedAt']);
        allow delete: if secretOwner() && secretParent().data.status == 'lobby';
      }

      match /guesses/{guessId} {
        function guessParent() {
          return get(/databases/$(database)/documents/chosungRooms/$(roomId));
        }

        function guessOwner() {
          return signedIn() && guessParent().data.ownerUid == request.auth.uid;
        }

        allow get: if signedIn() && (resource.data.uid == request.auth.uid || guessOwner());
        allow list: if guessOwner();

        allow create: if signedIn() &&
          validChosungGuess(request.resource.data) &&
          request.resource.data.uid == request.auth.uid &&
          guessParent().data.status == 'answering' &&
          (
            guessParent().data.get('stageStartedAt', null) == null ||
            request.time < guessParent().data.get('stageStartedAt', null) +
              duration.value(guessParent().data.get('clueSeconds', 20), 's')
          ) &&
          request.auth.uid in guessParent().data.activeUids &&
          !(request.auth.uid in guessParent().data.solvedUids) &&
          request.resource.data.question == guessParent().data.currentQuestion &&
          request.resource.data.clueStage == guessParent().data.clueStage &&
          request.resource.data.status == 'pending' &&
          request.resource.data.correct == false &&
          request.resource.data.awardedPoints == 0 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if guessOwner() &&
          validChosungGuess(resource.data) &&
          validChosungGuess(request.resource.data) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'resolved' &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.question == resource.data.question &&
          request.resource.data.clueStage == resource.data.clueStage &&
          request.resource.data.text == resource.data.text &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'correct', 'awardedPoints', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    match /eventRooms/{eventId} {
      function eventOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function eventPreparedCancellation() {
        return resource.data.status == 'preparing' &&
          resource.data.currentMatchId.matches('M[0-9]{3}') &&
          resource.data.currentGame != '' &&
          resource.data.matchNumber >= 1 &&
          request.resource.data.status == 'selecting' &&
          request.resource.data.currentMatchId == '' &&
          request.resource.data.currentGame == '' &&
          request.resource.data.joinOpen == resource.data.joinOpen &&
          request.resource.data.matchNumber == resource.data.matchNumber - 1;
      }

      allow get: if signedIn() && validRoomId(eventId);
      allow list: if false;

      allow create: if signedIn() &&
        validRoomId(eventId) &&
        validEventRoom(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'lobby' &&
        request.resource.data.joinOpen == true &&
        request.resource.data.currentMatchId == '' &&
        request.resource.data.currentGame == '' &&
        request.resource.data.matchNumber == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if eventOwner() &&
        validEventRoom(resource.data) &&
        validEventRoom(request.resource.data) &&
        request.resource.data.version == resource.data.version &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        (
          (
            request.resource.data.matchNumber >= resource.data.matchNumber &&
            request.resource.data.matchNumber <= resource.data.matchNumber + 1
          ) ||
          eventPreparedCancellation()
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'joinOpen', 'currentMatchId', 'currentGame', 'matchNumber', 'updatedAt'
        ]);

      allow delete: if eventOwner();

      match /participants/{participantUid} {
        function eventParent() {
          return get(/databases/$(database)/documents/eventRooms/$(eventId));
        }

        function eventParentAfter() {
          return getAfter(/databases/$(database)/documents/eventRooms/$(eventId));
        }

        function eventParentOwner() {
          return signedIn() && eventParent().data.ownerUid == request.auth.uid;
        }

        allow get, list: if signedIn() &&
          validRoomId(eventId) &&
          exists(/databases/$(database)/documents/eventRooms/$(eventId));

        allow create: if signedIn() &&
          validRoomId(eventId) &&
          participantUid == request.auth.uid &&
          existsAfter(/databases/$(database)/documents/eventRooms/$(eventId)) &&
          eventParentAfter().data.joinOpen == true &&
          eventParentAfter().data.status != 'finished' &&
          validEventParticipant(request.resource.data) &&
          request.resource.data.totalScore == 0 &&
          request.resource.data.joinedAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if validEventParticipant(resource.data) &&
          validEventParticipant(request.resource.data) &&
          request.resource.data.joinedAt == resource.data.joinedAt &&
          request.resource.data.eligibleFromMatch == resource.data.eligibleFromMatch &&
          request.resource.data.updatedAt == request.time &&
          (
            (
              signedIn() &&
              participantUid == request.auth.uid &&
              request.resource.data.totalScore == resource.data.totalScore &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'updatedAt'])
            ) ||
            (
              eventParentOwner() &&
              request.resource.data.nickname == resource.data.nickname &&
              request.resource.data.totalScore >= resource.data.totalScore &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalScore', 'updatedAt'])
            )
          );

        allow delete: if false;
      }

      match /matches/{matchId} {
        function matchEventParent() {
          return get(/databases/$(database)/documents/eventRooms/$(eventId));
        }

        function matchEventOwner() {
          return signedIn() && matchEventParent().data.ownerUid == request.auth.uid;
        }

        function matchEventParentAfter() {
          return getAfter(/databases/$(database)/documents/eventRooms/$(eventId));
        }

        function preparedMatchCancellation() {
          let eventBefore = matchEventParent().data;
          let eventAfter = matchEventParentAfter().data;
          return matchEventOwner() &&
            resource.data.status == 'preparing' &&
            eventBefore.status == 'preparing' &&
            eventBefore.currentMatchId == matchId &&
            eventBefore.currentGame == resource.data.gameType &&
            eventBefore.matchNumber >= 1 &&
            eventAfter.status == 'selecting' &&
            eventAfter.currentMatchId == '' &&
            eventAfter.currentGame == '' &&
            eventAfter.matchNumber == eventBefore.matchNumber - 1;
        }

        function participantAfter() {
          return getAfter(
            /databases/$(database)/documents/eventRooms/$(eventId)/participants/$(request.auth.uid)
          );
        }

        function selfPreparingJoin() {
          let added = request.resource.data.participantUids.toSet()
            .difference(resource.data.participantUids.toSet());
          let removed = resource.data.participantUids.toSet()
            .difference(request.resource.data.participantUids.toSet());
          return signedIn() &&
            resource.data.status == 'preparing' &&
            request.resource.data.status == resource.data.status &&
            !(request.auth.uid in resource.data.participantUids) &&
            request.auth.uid in request.resource.data.participantUids &&
            request.resource.data.participantUids.size() == resource.data.participantUids.size() + 1 &&
            added.hasOnly([request.auth.uid]) &&
            removed.size() == 0 &&
            existsAfter(
              /databases/$(database)/documents/eventRooms/$(eventId)/participants/$(request.auth.uid)
            ) &&
            validEventParticipant(participantAfter().data) &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids', 'updatedAt']);
        }

        allow get, list: if signedIn() &&
          validRoomId(eventId) &&
          exists(/databases/$(database)/documents/eventRooms/$(eventId));

        allow create: if matchEventOwner() &&
          matchId.matches('M[0-9]{3}') &&
          validEventMatch(request.resource.data) &&
          request.resource.data.status == 'preparing' &&
          request.resource.data.awards.size() == 0 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if (
            matchEventOwner() &&
            validEventMatch(resource.data) &&
            validEventMatch(request.resource.data) &&
            request.resource.data.version == resource.data.version &&
            request.resource.data.gameType == resource.data.gameType &&
            request.resource.data.title == resource.data.title &&
            request.resource.data.gameRoomId == resource.data.gameRoomId &&
            request.resource.data.get('isPractice', false) == resource.data.get('isPractice', false) &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'participantUids', 'awards', 'resultSummary', 'updatedAt'
            ])
          ) || selfPreparingJoin();

        allow delete: if preparedMatchCancellation();

        match /readiness/{participantUid} {
          function readinessMatch() {
            return get(/databases/$(database)/documents/eventRooms/$(eventId)/matches/$(matchId));
          }

          function readinessEvent() {
            return get(/databases/$(database)/documents/eventRooms/$(eventId));
          }

          function readinessBelongsToCurrentMatch() {
            return readinessEvent().data.currentMatchId == matchId &&
              (
                readinessEvent().data.status == 'preparing' ||
                readinessEvent().data.status == 'playing' ||
                readinessEvent().data.status == 'review'
              );
          }

          allow get: if signedIn() &&
            validRoomId(eventId) &&
            exists(/databases/$(database)/documents/eventRooms/$(eventId)) &&
            exists(/databases/$(database)/documents/eventRooms/$(eventId)/matches/$(matchId)) &&
            (participantUid == request.auth.uid || readinessEvent().data.ownerUid == request.auth.uid);

          allow list: if signedIn() &&
            validRoomId(eventId) &&
            exists(/databases/$(database)/documents/eventRooms/$(eventId)/matches/$(matchId)) &&
            readinessEvent().data.ownerUid == request.auth.uid;

          allow create: if signedIn() &&
            participantUid == request.auth.uid &&
            exists(/databases/$(database)/documents/eventRooms/$(eventId)/matches/$(matchId)) &&
            readinessBelongsToCurrentMatch() &&
            request.auth.uid in readinessMatch().data.participantUids &&
            validEventReadiness(request.resource.data) &&
            request.resource.data.gameType == readinessMatch().data.gameType &&
            request.resource.data.updatedAt == request.time;

          allow update: if signedIn() &&
            participantUid == request.auth.uid &&
            exists(/databases/$(database)/documents/eventRooms/$(eventId)/matches/$(matchId)) &&
            readinessBelongsToCurrentMatch() &&
            request.auth.uid in readinessMatch().data.participantUids &&
            validEventReadiness(resource.data) &&
            validEventReadiness(request.resource.data) &&
            request.resource.data.gameType == resource.data.gameType &&
            request.resource.data.gameType == readinessMatch().data.gameType &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'label', 'updatedAt']);

          allow delete: if signedIn() &&
            readinessEvent().data.ownerUid == request.auth.uid &&
            readinessEvent().data.status == 'preparing' &&
            readinessEvent().data.currentMatchId == matchId &&
            readinessMatch().data.status == 'preparing';
        }
      }

      match /ledger/{entryId} {
        function ledgerEventParent() {
          return get(/databases/$(database)/documents/eventRooms/$(eventId));
        }

        function ledgerEventOwner() {
          return signedIn() && ledgerEventParent().data.ownerUid == request.auth.uid;
        }

        allow get, list: if signedIn() &&
          validRoomId(eventId) &&
          exists(/databases/$(database)/documents/eventRooms/$(eventId));

        allow create: if ledgerEventOwner() &&
          validLedgerEntry(request.resource.data) &&
          entryId == request.resource.data.matchId + '_' + request.resource.data.participantUid &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
